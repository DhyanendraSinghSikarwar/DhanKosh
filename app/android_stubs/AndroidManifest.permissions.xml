<!--
  Merge these entries into android/app/src/main/AndroidManifest.xml
  (permissions go inside <manifest>, components inside <application>).
  The class names SmsReceiver and HisaabNotificationListener are not yet written.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Read the SMS inbox for the initial scan and 14-day/nightly catch-up of bank messages. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Receive new SMS live so transactions appear as they arrive. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Android 13+: show transaction, budget and card-due alerts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Biometric app lock (local_auth). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- IMAP email sync, forex/news fetch and update checks. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Skip network work when offline. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Sideloaded in-app update checker installs a downloaded APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Live SMS receiver. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Reads payment/bank app notifications (user grants in system settings). -->
        <service
            android:name=".HisaabNotificationListener"
            android:exported="true"
            android:label="Hisaab"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
